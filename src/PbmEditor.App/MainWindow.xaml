<Window x:Class="PbmEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:PbmEditor.App"
        xmlns:v="clr-namespace:PbmEditor.App.Views"
        Title="PBM Editor" Height="860" Width="1380" Closing="Window_Closing">
  <Window.Resources><BooleanToVisibilityConverter x:Key="BoolToVis"/></Window.Resources>
  <Grid>
  <DockPanel IsEnabled="{Binding IsNotBusy}">
    <Grid DockPanel.Dock="Top" Margin="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="380"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="{loc:T 'Mod / save:'}" Margin="4,0"/>
      <ComboBox Grid.Column="1" ItemsSource="{Binding Mods}" SelectedItem="{Binding SelectedMod}"/>
      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button Content="{loc:T 'New mod...'}" Command="{Binding NewModCommand}" ToolTip="{loc:T 'Create a new mod from the default game data'}"/>
        <Button Content="{loc:T 'Open file...'}" Command="{Binding BrowseCommand}"/>
        <Button Content="{loc:T 'Rescan'}" Command="{Binding RefreshModsCommand}"/>
      </StackPanel>
      <TextBlock Grid.Column="3" Text="{Binding Pending}" Foreground="DarkOrange" FontWeight="Bold" Margin="12,0"/>
      <StackPanel Grid.Column="4" Orientation="Horizontal">
        <TextBlock Text="{loc:T 'Language:'}" Margin="4,0"/>
        <ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding LanguageCode}" MinWidth="95"/>
        <Button Content="{loc:T 'Show changes'}" Command="{Binding ShowChangesCommand}"/>
        <Button Content="{loc:T 'Discard'}" Command="{Binding DiscardCommand}"/>
        <Button Content="{loc:T 'Save'}" Command="{Binding SaveCommand}" FontWeight="Bold"/>
      </StackPanel>
    </Grid>
    <StatusBar DockPanel.Dock="Bottom"><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/></StatusBar>
    <TabControl>
      <TabItem Header="{loc:T 'Teams and players'}"><v:TeamsView DataContext="{Binding Teams}"/></TabItem>
      <TabItem Header="{loc:T 'Free agents'}"><v:FreeAgentsView DataContext="{Binding FreeAgents}"/></TabItem>
      <TabItem Header="{loc:T 'Leagues and cups'}"><v:LeaguesView DataContext="{Binding Leagues}"/></TabItem>
      <TabItem Header="{loc:T 'Raw tables'}"><v:RawView DataContext="{Binding Raw}"/></TabItem>
    </TabControl>
  </DockPanel>
  <!-- busy overlay: blocks input and tells what is going on -->
  <Border Background="#B0FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
    <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="White" BorderBrush="#888" BorderThickness="1" CornerRadius="6" Padding="28,20">
      <StackPanel MinWidth="360">
        <TextBlock Text="{Binding BusyText}" FontSize="16" HorizontalAlignment="Center" TextWrapping="Wrap"/>
        <ProgressBar IsIndeterminate="True" Height="10" Margin="0,14,0,0"/>
      </StackPanel>
    </Border>
  </Border>
  </Grid>
</Window>
