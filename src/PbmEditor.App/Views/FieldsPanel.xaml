<UserControl x:Class="PbmEditor.App.Views.FieldsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:PbmEditor.App"
             xmlns:core="clr-namespace:PbmEditor.Core;assembly=PbmEditor.Core"
             xmlns:local="clr-namespace:PbmEditor.App.Views">
  <UserControl.Resources>
    <local:InvertBoolConverter x:Key="Invert"/>
    <DataTemplate x:Key="TextT">
      <TextBox Text="{Binding Text, UpdateSourceTrigger=LostFocus}" IsReadOnly="{Binding ReadOnly}"/>
    </DataTemplate>
    <DataTemplate x:Key="SliderT">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
        <Slider Minimum="{Binding Min}" Maximum="{Binding Max}" Value="{Binding Number}" IsEnabled="{Binding ReadOnly, Converter={StaticResource Invert}}"
                TickFrequency="{Binding Step}" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="3"/>
        <TextBox Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=LostFocus}" IsReadOnly="{Binding ReadOnly}"/>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="BoolT">
      <CheckBox IsChecked="{Binding Flag}" IsEnabled="{Binding ReadOnly, Converter={StaticResource Invert}}" Margin="3" VerticalAlignment="Center"/>
    </DataTemplate>
    <DataTemplate x:Key="ColorT">
      <StackPanel Orientation="Horizontal">
        <Border Width="40" Height="22" Margin="3" BorderBrush="Gray" BorderThickness="1" Background="{Binding Hex, Converter={StaticResource HexToBrush}}"/>
        <TextBox Width="90" Text="{Binding Hex, UpdateSourceTrigger=LostFocus}" ToolTip="{loc:T '#RRGGBB'}"/>
        <TextBlock Text="{Binding Text}" Foreground="Gray" Margin="6,0"/>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="ChoiceT">
      <ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                SelectedValue="{Binding ChoiceValue}" IsEnabled="{Binding ReadOnly, Converter={StaticResource Invert}}"
                TextSearch.TextPath="Label"/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type core:Field}">
      <Grid Margin="0,1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*" MaxWidth="420"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Label}" Margin="4,0">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Dirty}" Value="True">
                  <Setter Property="FontWeight" Value="Bold"/>
                  <Setter Property="Foreground" Value="DarkOrange"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <ContentControl Grid.Column="1" Content="{Binding}">
          <ContentControl.Style>
            <Style TargetType="ContentControl">
              <Setter Property="ContentTemplate" Value="{StaticResource TextT}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Slider"><Setter Property="ContentTemplate" Value="{StaticResource SliderT}"/></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Bool"><Setter Property="ContentTemplate" Value="{StaticResource BoolT}"/></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Color"><Setter Property="ContentTemplate" Value="{StaticResource ColorT}"/></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Choice"><Setter Property="ContentTemplate" Value="{StaticResource ChoiceT}"/></DataTrigger>
              </Style.Triggers>
            </Style>
          </ContentControl.Style>
        </ContentControl>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <ItemsControl x:Name="List">
      <ItemsControl.GroupStyle>
        <GroupStyle>
          <GroupStyle.ContainerStyle>
            <Style TargetType="GroupItem">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="GroupItem">
                    <Expander Header="{Binding Name}" IsExpanded="True" Margin="0,2" FontWeight="SemiBold">
                      <ItemsPresenter Margin="6,2,0,6" TextElement.FontWeight="Normal"/>
                    </Expander>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </GroupStyle.ContainerStyle>
        </GroupStyle>
      </ItemsControl.GroupStyle>
    </ItemsControl>
  </ScrollViewer>
</UserControl>
