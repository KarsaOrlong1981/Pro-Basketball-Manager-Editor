<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>PbmEditor</AssemblyName>
    <Version>0.0.2-alpha</Version>
    <AssemblyVersion>0.0.2.0</AssemblyVersion>
    <FileVersion>0.0.2.0</FileVersion>
    <Product>PBM Editor</Product>
    <Copyright>MIT License</Copyright>
  </PropertyGroup>
  <!-- app icon (taskbar, desktop, exe): used as soon as the file exists -->
  <PropertyGroup Condition="Exists('Assets\app.ico')">
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup Condition="Exists('Assets\app.ico')">
    <Resource Include="Assets\app.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PbmEditor.Core\PbmEditor.Core.csproj" />
  </ItemGroup>
</Project>
